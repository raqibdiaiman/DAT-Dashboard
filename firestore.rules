rules_version = '2';
// Only signed-in users with a VERIFIED work email from
// @mnrb.com.my, @malaysian-re.com.my or @takaful-ikhlas.com.my
// can read or edit the DAT tracker. Everything else is blocked.
service cloud.firestore {
  match /databases/{database}/documents {
    function isGroupStaff() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@(mnrb|malaysian-re|takaful-ikhlas)[.]com[.]my$');
    }
    match /{collection}/{docId} {
      allow read, write: if isGroupStaff()
        && collection in ['mainProjects', 'subProjects', 'projectIssues', 'meta', 'backups'];
    }
  }
}
