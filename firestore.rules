rules_version = '2';
// Anyone with the app link can read and edit the DAT tracker data (no login).
// Only the tracker's own collections are open; everything else is blocked.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection}/{docId} {
      allow read, write: if collection in ['mainProjects', 'subProjects', 'projectIssues', 'meta'];
    }
  }
}
